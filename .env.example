# ── LLM provider ─────────────────────────────────────────────────────────
# Options: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Voyage AI — used if EMBEDDING_PROVIDER=anthropic. Voyage is Anthropic's
# recommended embedding partner but issues its own separate API key:
# https://dash.voyageai.com
VOYAGE_API_KEY=

# OpenAI (used if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama — only used if LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama.
# NOT recommended on Intel Mac: no GPU access in Docker means 60s+ per
# response. Works well on Apple Silicon, Linux+NVIDIA, or Windows+NVIDIA.
# After the stack is up, pull models with:
#   make ollama-pull-llm
#   make ollama-pull-embed
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=

# ── Embeddings ────────────────────────────────────────────────────────────
# Options: anthropic (Voyage) | openai | ollama
EMBEDDING_PROVIDER=anthropic
EMBEDDING_MODEL=voyage-3-lite
# voyage-3-lite=1024, openai text-embedding-3-small=1536, nomic-embed-text=768
EMBEDDING_DIM=1024

# ── Evidence gate ─────────────────────────────────────────────────────────
# Answers with retrieval confidence below this are declined, not guessed.
EVIDENCE_CONFIDENCE_THRESHOLD=0.45
